{
    "app-id": "io.github.nicobm.GtiClubRecomp",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "26.08",
    "sdk": "org.freedesktop.Sdk",
    "base": "org.winehq.Wine",
    "base-version": "stable-26.08",
    "command": "racing-club-launch",
    "finish-args": [
        "--share=network",
        "--share=ipc",
        "--socket=wayland",
        "--socket=pulseaudio",
        "--allow=devel",
        "--device=dri",
        "--device=input",
        "--filesystem=home",
        "--nofilesystem=host"
    ],
    "cleanup": [
        "/share/applications/org.winehq.Wine.desktop",
        "/share/applications/winetricks.desktop",
        "/share/icons/hicolor/*/apps/org.winehq.Wine.*",
        "/share/icons/hicolor/scalable/apps/winetricks.svg",
        "/share/metainfo/org.winehq.Wine.metainfo.xml",
        "/share/metainfo/io.github.winetricks.Winetricks.metainfo.xml"
    ],
    "cleanup-commands": [
        "rm -f /app/share/applications/org.winehq.Wine.desktop /app/share/applications/winetricks.desktop",
        "rm -f /app/share/icons/hicolor/*/apps/org.winehq.Wine.* /app/share/icons/hicolor/scalable/apps/winetricks.svg",
        "rm -f /app/share/metainfo/org.winehq.Wine.metainfo.xml /app/share/metainfo/io.github.winetricks.Winetricks.metainfo.xml"
    ],
    "modules": [
        {
            "name": "racing-club",
            "buildsystem": "simple",
            "build-commands": [
                "mkdir -p /app/share/racing-club/game",
                "cp -a game/. /app/share/racing-club/game/",
                "install -Dm755 racing-club-launch /app/bin/racing-club-launch",
                "install -Dm644 io.github.nicobm.GtiClubRecomp.desktop /app/share/applications/io.github.nicobm.GtiClubRecomp.desktop",
                "install -Dm644 io.github.nicobm.GtiClubRecomp.svg /app/share/icons/hicolor/scalable/apps/io.github.nicobm.GtiClubRecomp.svg",
                "install -Dm644 io.github.nicobm.GtiClubRecomp.metainfo.xml /app/share/metainfo/io.github.nicobm.GtiClubRecomp.metainfo.xml"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": "prebuilt",
                    "dest": "game"
                },
                {
                    "type": "file",
                    "path": "flatpak/racing-club-launch"
                },
                {
                    "type": "file",
                    "path": "flatpak/io.github.nicobm.GtiClubRecomp.desktop"
                },
                {
                    "type": "file",
                    "path": "flatpak/io.github.nicobm.GtiClubRecomp.svg"
                },
                {
                    "type": "file",
                    "path": "flatpak/io.github.nicobm.GtiClubRecomp.metainfo.xml"
                }
            ]
        }
    ]
}
