#!/bin/sh
# Lanzador de Racing Club+ dentro del Flatpak.
#
# /app es de solo lectura, pero el juego escribe ajustes, partidas y logs en
# su carpeta. La primera vez copiamos el juego compilado a la carpeta de datos
# de la app (~/.var/app/.../data) y ejecutamos Racing Club+.exe con Wine.
set -eu

APP_ID="io.github.nicobm.GtiClubRecomp"
SRC_DIR="/app/share/racing-club/game"

DATA_HOME="${XDG_DATA_HOME:-$HOME/.var/app/$APP_ID/data}"
GAME_DIR="$DATA_HOME/racing-club/game"

mkdir -p "$GAME_DIR"

if [ ! -f "$GAME_DIR/Racing Club+.exe" ]; then
    echo "Racing Club+: copiando el juego a $GAME_DIR (primera vez)..."
fi
cp -rn "$SRC_DIR/." "$GAME_DIR/" 2>/dev/null || true
chmod -R u+w "$GAME_DIR" 2>/dev/null || true

if [ ! -f "$GAME_DIR/Racing Club+.exe" ]; then
    echo "Racing Club+: no se pudo copiar el juego." >&2
    exit 1
fi

# Con antialiasing=0 y nitidez=0 el juego usa glBlitFramebuffer directo, que
# en AMD/Mesa (y llvmpipe) deja la ventana en blanco. Si el ini viejo del
# usuario tiene ambos en 0, activamos AA para forzar el present por shader.
INI="$GAME_DIR/gtiport.ini"
if [ -f "$INI" ] &&
    grep -q '^antialiasing=0' "$INI" &&
    grep -q '^nitidez=0' "$INI"; then
    echo "Racing Club+: activando present por shader (evita ventana blanca)..."
    sed -i 's/^antialiasing=[^[:space:]]*/antialiasing=1/' "$INI"
fi

export WINEPREFIX="$DATA_HOME/wineprefix"
export WINEARCH=win64
export WINEDEBUG="${RACING_CLUB_WINEDEBUG:--all}"

# El GL por hardware de este Flatpak falla en algunas AMD/Mesa; llvmpipe
# abre el juego. Se puede forzar hardware con RACING_CLUB_SOFTWARE_GL=0.
# En hardware desactivamos la variable (no la ponemos en 0): así también se
# ignora un LIBGL_ALWAYS_SOFTWARE=1 heredado de un override viejo.
if [ "${RACING_CLUB_SOFTWARE_GL:-1}" = "1" ]; then
    export LIBGL_ALWAYS_SOFTWARE=1
    echo "Racing Club+: OpenGL por software (llvmpipe)."
else
    unset LIBGL_ALWAYS_SOFTWARE
    echo "Racing Club+: OpenGL por hardware."
fi

# El glcache del paquete es de la GPU del autor; en otra GPU los binarios se
# rechazan y el juego recompila. Se borra UNA sola vez: si se borra en cada
# arranque, se pierde la caché ya regenerada para esta GPU y todo va lento
# (o parece colgado mientras recompila). RACING_CLUB_RESET_GLCACHE=1 fuerza
# el borrado; RACING_CLUB_KEEP_GLCACHE=1 conserva incluso el del autor.
if [ "${RACING_CLUB_RESET_GLCACHE:-0}" = "1" ]; then
    rm -rf "$GAME_DIR/glcache"
    : > "$GAME_DIR/.glcache-cleaned"
elif [ "${RACING_CLUB_KEEP_GLCACHE:-0}" != "1" ] && [ ! -e "$GAME_DIR/.glcache-cleaned" ]; then
    rm -rf "$GAME_DIR/glcache"
    : > "$GAME_DIR/.glcache-cleaned"
fi
# El juego es un .exe de Windows: SDL crea el contexto con WGL, que Wine
# traduce al driver X11 o al de Wayland. Con el driver Wayland el hardware
# falla con "No matching GL pixel format available"; X11 sí encuentra el
# pixel format. Si el Flatpak expone X11, preferimos X11.
# RACING_CLUB_VIDEO=wayland fuerza el driver Wayland.
if [ "${RACING_CLUB_VIDEO:-}" = "wayland" ]; then
    unset DISPLAY
    echo "Racing Club+: Wine sobre Wayland."
elif [ -n "${DISPLAY:-}" ]; then
    unset WAYLAND_DISPLAY
    echo "Racing Club+: Wine sobre X11 (DISPLAY=$DISPLAY)."
fi

# El juego usa OpenGL. winevulkan=d evita que Wine intente radv/Vulkan.
export WINEDLLOVERRIDES="${RACING_CLUB_WINEDLLOVERRIDES:-mscoree=d;mshtml=d;winevulkan=d;vulkan-1=d}"

if [ -x /app/bin/wine ]; then WINE=/app/bin/wine; else WINE=wine; fi
if [ -x /app/bin/wineboot ]; then WINEBOOT=/app/bin/wineboot; else WINEBOOT=wineboot; fi

if [ ! -d "$WINEPREFIX/drive_c" ]; then
    echo "Racing Club+: preparando el prefijo de Wine (primera vez)..."
    "$WINEBOOT" -u >/dev/null 2>&1 || true
fi

cd "$GAME_DIR"
exec "$WINE" "$GAME_DIR/Racing Club+.exe" "$@"
